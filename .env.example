APP_NAME="NEST Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nest_market
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BCRYPT_ROUNDS=12

# Docker Compose (independent from the native/Laragon database settings above)
APP_PORT=8082
DOCKER_APP_URL=http://localhost:8082
FORWARD_DB_PORT=13306
DOCKER_DB_DATABASE=nest_market
DOCKER_DB_USERNAME=nest_market
DOCKER_DB_PASSWORD=nest_local_password
DOCKER_DB_ROOT_PASSWORD=nest_local_root_password
